# Credentials for the agent user only. /etc/workq/agent.env, owner workq-agent, mode 600.
# Set ONE of these.

# Subscription seat (Pro, Max, Team): run `claude setup-token` as the seat's owner
# and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=

# Or an Anthropic API key (Console billing):
# ANTHROPIC_API_KEY=

# Path to Claude Code, if it isn't on the agent user's PATH (~/.local/bin is added).
# CLAUDE_BIN=/home/workq-agent/.local/bin/claude
