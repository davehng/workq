# Credentials for Claude Code in a single-user install: ~/.config/workq/claude.env, mode 600.
# The runner gives these to the Claude process only. Set ONE of the two.

# Subscription seat (Team, Pro, Max): run `claude setup-token` as the seat's owner on any
# machine with a browser, and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=

# Or an Anthropic API key (Console billing):
# ANTHROPIC_API_KEY=
