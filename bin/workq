#!/usr/bin/env python3
"""workq entry point. The program itself is in ../lib/workq/."""
import os
import sys

_LIB = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib")
if _LIB not in sys.path:
    sys.path.insert(0, _LIB)

from workq.runner import *  # noqa: E402,F401,F403  (tests load this file and call the runner's functions)
from workq import runner as _runner  # noqa: E402

if __name__ == "__main__":
    sys.exit(_runner.cli())
