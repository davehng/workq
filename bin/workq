    YAML_SOURCE = "system PyYAML"
except ImportError:  # no PyYAML on this machine: use the copy shipped in lib/
    sys.path.insert(0, str(PKG_DIR / "lib"))
    import yaml
    YAML_SOURCE = "bundled PyYAML"

VERSION = "0.2.0"

STAGES = ["file", "shape", "exec-haiku", "exec-sonnet", "exec-opus", "check"]
